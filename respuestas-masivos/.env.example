# Copia este archivo como ".env" y rellena tus datos.

# --- Gmail / Google Workspace (buzón donde llegan las respuestas) ---
GMAIL_USER=support@jycequipment.com
# Contraseña de aplicación (16 letras): https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Buzones adicionales donde también llegan respuestas (opcional):
GMAIL_USER_2=jp@jycmedical.com
GMAIL_APP_PASSWORD_2=
# GMAIL_USER_3=ventas@tuempresa.com
# GMAIL_APP_PASSWORD_3=

# Opcional: carpeta específica. Vacío = "Todos los correos" (incluye archivados).
GMAIL_FOLDER=

# --- Instantly (opcional) ---
# API key v2: Instantly > Settings > Integrations > API Keys (scope de lectura)
INSTANTLY_API_KEY=

# --- Constant Contact (opcional) ---
# Token de acceso o credenciales de la app en https://app.constantcontact.com/pages/dma/portal/
CONSTANT_CONTACT_ACCESS_TOKEN=
CONSTANT_CONTACT_CLIENT_ID=
CONSTANT_CONTACT_CLIENT_SECRET=
CONSTANT_CONTACT_REFRESH_TOKEN=

# --- General ---
SYNC_INTERVAL_MINUTES=15
# Días hacia atrás a buscar si la campaña no tiene fecha de envío
LOOKBACK_DAYS=30
# 127.0.0.1 = solo este PC. 0.0.0.0 = accesible desde la red de la oficina.
HOST=127.0.0.1
PORT=5000
SECRET_KEY=cambia-esta-clave
